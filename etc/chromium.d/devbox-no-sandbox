# Флаги Chromium по умолчанию — штатная папка запускалки Debian (/etc/chromium.d).
# В контейнере у браузера нет прав на собственную песочницу, и без этого флага он не стартует:
# границей служит сам контейнер. Файл лежит в образе всегда; работает только у того, кто поставил
# браузер фичей в своём devcontainer.json.
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox"
